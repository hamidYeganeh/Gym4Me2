{
  "name": "@repo/theme",
  "version": "0.0.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./provider": "./src/providers/ThemeProvider/index.ts",
    "./theme.css": "./src/theme.css",
    "./tailwind.css": "./src/styles/tailwind.css",
    "./utilities.css": "./src/styles/utilities.css",
    "./tokens/*.css": "./src/styles/tokens/*.css"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "next-themes": "^0.4.6"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^24",
    "@types/react": "19.2.18",
    "eslint": "10.9.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
