diff --git a/scripts/check-workspace-dependencies.mjs b/scripts/check-workspace-dependencies.mjs
new file mode 100644
index 0000000..2157e20
--- /dev/null
+++ b/scripts/check-workspace-dependencies.mjs
@@ -0,0 +1,170 @@
+import { isBuiltin, createRequire } from "node:module";
+import { existsSync, readFileSync, readdirSync } from "node:fs";
+import { join, relative, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+
+// Use the same declared TypeScript parser as application builds, without loading apps.
+const require = createRequire(
+  new URL("../apps/application/package.json", import.meta.url),
+);
+const ts = require("typescript");
+const generated = new Set([
+  "node_modules",
+  "dist",
+  "out",
+  "build",
+  "coverage",
+  "android",
+  "ios",
+  "public",
+]);
+
+function* sourceFiles(directory) {
+  for (const entry of readdirSync(directory, { withFileTypes: true })) {
+    const path = join(directory, entry.name);
+    if (
+      entry.isDirectory() &&
+      !entry.name.startsWith(".") &&
+      !generated.has(entry.name)
+    )
+      yield* sourceFiles(path);
+    else if (entry.isFile() && /\.[cm]?[jt]sx?$/.test(entry.name)) yield path;
+  }
+}
+
+function importedPackages(file, source) {
+  const parsed = ts.createSourceFile(
+    file,
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+  );
+  const imports = [];
+  const record = (node, typeOnly = false) => {
+    if (node && ts.isStringLiteralLike(node))
+      imports.push({
+        specifier: node.text,
+        typeOnly,
+        line:
+          parsed.getLineAndCharacterOfPosition(node.getStart(parsed)).line + 1,
+      });
+  };
+  const visit = (node) => {
+    if (ts.isImportDeclaration(node)) {
+      const clause = node.importClause;
+      const bindings = clause?.namedBindings;
+      record(
+        node.moduleSpecifier,
+        Boolean(
+          clause?.isTypeOnly ||
+          (!clause?.name &&
+            bindings &&
+            ts.isNamedImports(bindings) &&
+            bindings.elements.length &&
+            bindings.elements.every((item) => item.isTypeOnly)),
+        ),
+      );
+    } else if (ts.isExportDeclaration(node))
+      record(
+        node.moduleSpecifier,
+        node.isTypeOnly ||
+          Boolean(
+            node.exportClause &&
+            ts.isNamedExports(node.exportClause) &&
+            node.exportClause.elements.length &&
+            node.exportClause.elements.every((item) => item.isTypeOnly),
+          ),
+      );
+    else if (
+      ts.isImportEqualsDeclaration(node) &&
+      ts.isExternalModuleReference(node.moduleReference)
+    )
+      record(node.moduleReference.expression, node.isTypeOnly);
+    else if (ts.isImportTypeNode(node) && ts.isLiteralTypeNode(node.argument))
+      record(node.argument.literal, true);
+    else if (
+      ts.isCallExpression(node) &&
+      (node.expression.kind === ts.SyntaxKind.ImportKeyword ||
+        (ts.isIdentifier(node.expression) &&
+          node.expression.text === "require"))
+    )
+      record(node.arguments[0]);
+    ts.forEachChild(node, visit);
+  };
+  visit(parsed);
+  return imports;
+}
+
+/** Detect undeclared direct imports that a developer's hoisted modules can conceal. */
+export function scanWorkspaceDependencies(root) {
+  const result = { workspaces: 0, files: 0, missing: [] };
+  for (const group of ["apps", "packages"]) {
+    const parent = join(root, group);
+    if (!existsSync(parent)) continue;
+    for (const entry of readdirSync(parent, { withFileTypes: true })) {
+      if (!entry.isDirectory() || entry.name.startsWith(".")) continue;
+      const workspace = join(parent, entry.name),
+        manifest = join(workspace, "package.json");
+      if (!existsSync(manifest)) continue;
+      const pkg = JSON.parse(readFileSync(manifest, "utf8"));
+      const declared = new Set([
+        pkg.name,
+        ...[
+          "dependencies",
+          "devDependencies",
+          "peerDependencies",
+          "optionalDependencies",
+        ].flatMap((key) => Object.keys(pkg[key] ?? {})),
+      ]);
+      result.workspaces++;
+      for (const file of sourceFiles(workspace)) {
+        result.files++;
+        for (const item of importedPackages(file, readFileSync(file, "utf8"))) {
+          const name = item.specifier;
+          // @/ is the existing Next tsconfig alias, never an npm package.
+          if (
+            name.startsWith(".") ||
+            name.startsWith("/") ||
+            name.startsWith("@/") ||
+            name.startsWith("#") ||
+            isBuiltin(name)
+          )
+            continue;
+          const dependency = name.startsWith("@")
+            ? name.split("/").slice(0, 2).join("/")
+            : name.split("/")[0];
+          const types = `@types/${dependency.startsWith("@") ? dependency.slice(1).replace("/", "__") : dependency}`;
+          if (
+            !declared.has(dependency) &&
+            !(item.typeOnly && declared.has(types))
+          )
+            result.missing.push({
+              workspace: relative(root, workspace),
+              source: relative(root, file),
+              ...item,
+              dependency,
+            });
+        }
+      }
+    }
+  }
+  return result;
+}
+
+if (
+  process.argv[1] &&
+  resolve(process.argv[1]) === fileURLToPath(import.meta.url)
+) {
+  const result = scanWorkspaceDependencies(
+    fileURLToPath(new URL("..", import.meta.url)),
+  );
+  for (const item of result.missing)
+    console.error(
+      `${item.source}:${item.line}: declare ${item.dependency} in ${item.workspace}/package.json (imports ${item.specifier})`,
+    );
+  if (result.missing.length) process.exitCode = 1;
+  else
+    console.log(
+      `${result.workspaces} workspace manifests cover direct imports in ${result.files} source files.`,
+    );
+}
diff --git a/scripts/check-workspace-dependencies.test.mjs b/scripts/check-workspace-dependencies.test.mjs
new file mode 100644
index 0000000..3e7800c
--- /dev/null
+++ b/scripts/check-workspace-dependencies.test.mjs
@@ -0,0 +1,80 @@
+import assert from "node:assert/strict";
+import {
+  mkdtempSync,
+  mkdirSync,
+  readFileSync,
+  writeFileSync,
+  rmSync,
+} from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import { scanWorkspaceDependencies } from "./check-workspace-dependencies.mjs";
+
+test("a clean workspace reports a hoisted-only runtime, re-export and type dependency", () => {
+  const root = mkdtempSync(join(tmpdir(), "gym4me-dependencies-"));
+  try {
+    const workspace = join(root, "apps", "application");
+    mkdirSync(workspace, { recursive: true });
+    writeFileSync(
+      join(workspace, "package.json"),
+      JSON.stringify({
+        name: "app",
+        dependencies: { react: "1", "@scope/direct": "1" },
+        devDependencies: { typescript: "1", "@types/express": "1" },
+        peerDependencies: { peer: "1" },
+      }),
+    );
+    writeFileSync(
+      join(workspace, "source.tsx"),
+      `
+import { Camera } from 'lucide-react';
+export { item } from '@missing/reexport/subpath';
+type Data = import('missing-types').Data;
+import type { Component } from 'react';
+import type { Request } from 'express';
+import { type Response } from 'express';
+import { readFile } from 'node:fs/promises';
+import direct from '@scope/direct/subpath';
+import local from '@/components/local';
+import sibling from './local';
+import self from 'app/subpath';
+const peer = import('peer');
+const ts = require('typescript');
+// import fake from 'a-comment-is-not-an-import';
+const example = "import fake from 'a-string-is-not-an-import'";
+`,
+    );
+    // Generated/native/vendor code must not invent workspace requirements.
+    for (const dir of ["node_modules", ".next-qa", "android", "public"]) {
+      mkdirSync(join(workspace, dir));
+      writeFileSync(
+        join(workspace, dir, "vendor.js"),
+        "require('unrelated-vendor')",
+      );
+    }
+    const result = scanWorkspaceDependencies(root);
+    assert.deepEqual(
+      result.missing.map((x) => x.dependency),
+      ["lucide-react", "@missing/reexport", "missing-types"],
+    );
+    assert.equal(result.files, 1);
+    const manifest = JSON.parse(
+      readFileSync(join(workspace, "package.json"), "utf8"),
+    );
+    for (const item of result.missing)
+      manifest.dependencies[item.dependency] = "1";
+    writeFileSync(join(workspace, "package.json"), JSON.stringify(manifest));
+    assert.deepEqual(scanWorkspaceDependencies(root).missing, []);
+    writeFileSync(
+      join(workspace, "runtime.ts"),
+      "import express from 'express';",
+    );
+    assert.deepEqual(
+      scanWorkspaceDependencies(root).missing.map((item) => item.dependency),
+      ["express"],
+    );
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
