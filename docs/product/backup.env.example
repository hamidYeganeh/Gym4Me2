# Copy into .ops-private/backup.env only after choosing actual repositories.
# This example is not a usable configuration; no credentials belong here.
RESTIC_REPOSITORY=
LEDGER_REPOSITORY=
RESTIC_PASSWORD_FILE=
# Retention requires BOTH values. Example ranges: days1..3650, last1..10000.
# No retention command is scheduled automatically. No ledger snapshots are forgotten.
BACKUP_RETENTION_DAYS=
BACKUP_RETENTION_LAST=
