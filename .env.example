# Local PostgreSQL settings for docker compose -f compose.dev.yaml
POSTGRES_DB=gym4me
POSTGRES_USER=gym4me
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433

# Run the backend with these variables exported
DATABASE_URL=postgresql://gym4me:change-me-local-only@127.0.0.1:5433/gym4me
AUTH_SECRET=
# Optional comma-separated IPs/CIDRs for infrastructure that sanitizes forwarded headers
AUTH_TRUSTED_PROXIES=
# Use kavenegar to test live SMS locally. Production always uses Kavenegar.
OTP_MODE=console
APPLICANT_ORIGINS=http://localhost:3000,http://localhost,capacitor://localhost
PANEL_OTP_API_ORIGIN=http://127.0.0.1:3003
NEXT_PUBLIC_CLUB_API_ORIGIN=http://localhost:3003
NEXT_PUBLIC_BUSINESS_PANEL_URL=http://localhost:3002
NEXT_PUBLIC_CLUB_APPLICATION_URL=http://localhost:3000/club-registration/
# Backend only
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=gym4meotp
# Set to g4m-set-password once approved. Blank uses the OTP template.
KAVENEGAR_PASSWORD_RESET_TEMPLATE=

# Private S3 bucket for club galleries. Leave endpoint blank for AWS.
CLUB_MEDIA_S3_BUCKET=
CLUB_MEDIA_S3_REGION=us-east-1
CLUB_MEDIA_S3_ENDPOINT=
# Configure AWS SDK credentials in the backend environment or use an IAM role.

# Optional raster tile provider for the club pin picker.
# NEXT_PUBLIC_CLUB_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_CLUB_MAP_ATTRIBUTION=
