<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="gym4me.ir" android:pathPrefix="/discovery/clubs/" />
                <data android:scheme="https" android:host="gym4me.ir" android:pathPrefix="/services/" />
                <data android:scheme="https" android:host="gym4me.ir" android:pathPrefix="/calendars/" />
                <data android:scheme="https" android:host="gym4me.ir" android:pathPrefix="/bookings/" />
                <data android:scheme="https" android:host="gym4me.ir" android:pathPrefix="/orders/" />
                <data android:scheme="https" android:host="gym4me.ir" android:pathPrefix="/messages/" />
                <data android:scheme="https" android:host="gym4me.ir" android:pathPrefix="/memberships/" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gym4me" android:host="club" />
                <data android:scheme="gym4me" android:host="service" />
                <data android:scheme="gym4me" android:host="services" />
                <data android:scheme="gym4me" android:host="calendar" />
                <data android:scheme="gym4me" android:host="calendars" />
                <data android:scheme="gym4me" android:host="booking" />
                <data android:scheme="gym4me" android:host="bookings" />
                <data android:scheme="gym4me" android:host="order" />
                <data android:scheme="gym4me" android:host="orders" />
                <data android:scheme="gym4me" android:host="conversation" />
                <data android:scheme="gym4me" android:host="messages" />
                <data android:scheme="gym4me" android:host="membership" />
                <data android:scheme="gym4me" android:host="memberships" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
