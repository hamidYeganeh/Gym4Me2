{
  "name": "application",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 7081",
    "build": "next build",
    "start": "next start --port 7081",
    "lint": "eslint",
    "check-types": "next typegen && tsc --noEmit",
    "build:native": "node scripts/build-native.mjs",
    "native:sync": "pnpm build:native && cap sync",
    "native:android": "cap open android",
    "native:ios": "cap open ios",
    "native:run:android": "cap run android",
    "native:run:ios": "cap run ios",
    "native:apk": "cd android && ./gradlew :app:assembleDebug",
    "native:aab": "cd android && ./gradlew :app:bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/status-bar": "^8.0.4",
    "@repo/i18n": "workspace:*",
    "@repo/theme": "workspace:*",
    "@repo/ui": "workspace:*",
    "next": "16.4.0",
    "next-intl": "^4.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
