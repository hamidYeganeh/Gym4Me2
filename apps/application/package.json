{
  "name": "application",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "build:native": "NEXT_PUBLIC_CAPACITOR_EXPORT=1 next build",
    "lint": "eslint . --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "native:add:ios": "cap add ios",
    "native:add:android": "cap add android",
    "native:sync": "npm run build:native && cap sync",
    "native:open:ios": "cap open ios",
    "native:open:android": "cap open android",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@repo/icons": "*",
    "@repo/theme": "*",
    "@repo/ui": "*",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/android": "8.6.2",
    "@repo/api": "*",
    "@repo/i18n": "*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.9.1",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@tailwindcss/postcss": "4.3.3",
    "@capacitor/cli": "8.6.2",
    "vitest": "^5.1.0"
  }
}
