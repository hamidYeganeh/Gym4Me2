PORT=7088
NODE_ENV=development
# Local development only; compose.yaml binds PostgreSQL to loopback.
DATABASE_URL=postgresql://gym4me:gym4me_local@127.0.0.1:55432/gym4me
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
# Documentation is enabled outside production by default.
# API_DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:7081,http://localhost:7082,http://localhost:7083,capacitor://localhost,https://localhost

# Generate a unique secret with: openssl rand -hex 32
# AUTH_SECRET=
# A key alone never enables live SMS. Explicitly choose kavenegar when ready.
# Selecting kavenegar disables demo OTPs and retires old demo sessions, even with DEMO_MODE=true.
SMS_PROVIDER=disabled
KAVENEGAR_OTP_TEMPLATE=gym4meotp
AUTH_APPLICATION_ORIGIN=http://localhost:7081
AUTH_BUSINESS_ORIGIN=http://localhost:7083
AUTH_ADMIN_ORIGIN=http://localhost:7082

# Local S3-compatible object storage; use separate credentials per deployed environment.
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=gym4me
S3_ACCESS_KEY_ID=gym4me_local
S3_SECRET_ACCESS_KEY=gym4me_local_storage
S3_FORCE_PATH_STYLE=true
PUBLIC_API_ORIGIN=http://localhost:7088

# Proposed defaults for the local PH1 pilot. Review before public release.
PRIVACY_POLICY_VERSION=local-pilot-v1
ACCOUNT_MINIMUM_AGE=18
ACCOUNT_DELETION_GRACE_DAYS=7
OTP_RETENTION_DAYS=7
SESSION_RETENTION_DAYS=30
INVITATION_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
BACKUP_RETENTION_DAYS=30
RETENTION_INTERVAL_MINUTES=60
RETENTION_ENABLED=true

# Unreferenced uploaded images and abandoned S3 objects (days)
MEDIA_ORPHAN_GRACE_DAYS=7

# Bind staging to loopback until its HTTPS reverse proxy is configured.
API_HOST=0.0.0.0
KAVENEGAR_API_KEY=KAVEHNEGARD_API

# Enable after gym4meotp includes %token2 as its last line. Use the signing certificate hash for this environment.
# KAVENEGAR_ANDROID_APP_HASH=

# Explicit free Web Push activation. Generate one VAPID pair; keep its private key secret.
PUSH_PROVIDER=disabled
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://gym4me.ir
