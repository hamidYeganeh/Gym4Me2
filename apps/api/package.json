{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\" drizzle.config.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node ../../scripts/check-ui-fixture.mjs && jest --config ./test/jest-e2e.json",
    "dev": "nest start --watch",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test:db": "node ../../scripts/check-ui-fixture.mjs && tsx --test test/database.integration.test.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "test:auth": "node ../../scripts/check-ui-fixture.mjs && jest --config ./test/jest.integration.json --runInBand",
    "test:commerce": "node ../../scripts/check-ui-fixture.mjs && jest --config ./test/jest.commerce.json --runInBand",
    "test:notifications": "node --import tsx --test test/notification-delivery.integration.test.ts",
    "test:clubs": "node ../../scripts/check-ui-fixture.mjs && jest --config ./test/jest.clubs.json --runInBand",
    "test:locations": "node ../../scripts/check-ui-fixture.mjs && jest --config ./test/jest.locations.json --runInBand",
    "data:retention": "ts-node scripts/retain-data.ts",
    "test:ui": "ts-node test/ui.fixture.ts",
    "media:retention": "ts-node scripts/retain-media.ts",
    "backup:drill": "node --import tsx scripts/backup-drill.ts",
    "data:deletion-ledger": "ts-node scripts/deletion-ledger.ts",
    "data:deletion-journal": "ts-node scripts/deletion-journal.ts",
    "test:training": "jest --config test/jest.training.json --runInBand",
    "test:ph5": "node --import tsx --test test/ph5.integration.test.ts",
    "test:completion": "ts-node test/completion.integration.test.ts",
    "test:multisport": "ts-node test/multisport.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@repo/i18n": "workspace:*",
    "@vercel/blob": "2.8.2",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "web-push": "3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
