{
  "name": "gym4me",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:storybook": "npm run build --workspace=@repo/storybook",
    "check": "npm run lint && npm run check-types && npm run check:deps && npm run format:check",
    "check-types": "turbo run check-types",
    "check:deps": "node scripts/check-dependencies.mjs",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint && eslint *.mjs scripts/*.mjs .dependency-cruiser.cjs --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "prepare": "husky",
    "storybook": "npm run dev --workspace=@repo/storybook",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@repo/eslint-config": "*",
    "@repo/prettier-config": "*",
    "@types/node": "^24",
    "dependency-cruiser": "^18.7.2",
    "eslint": "10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.1",
    "prettier": "3.9.10",
    "shadcn": "^4.23.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.2.1"
    }
  },
  "volta": {
    "node": "24.15.0",
    "npm": "12.2.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "esbuild": false,
    "@swc/core": false,
    "@parcel/watcher": false
  },
  "packageManager": "npm@12.2.1"
}
