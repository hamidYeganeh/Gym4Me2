# Local isolated staging only. Generate .env.staging with scripts/staging.mjs init.
STAGE_ADMIN_PASSWORD=replace-me
STAGE_MIGRATION_PASSWORD=replace-me
STAGE_RUNTIME_PASSWORD=replace-me
DATABASE_URL=postgresql://gym4me_runtime:replace-me@127.0.0.1:55434/gym4me_stage
MIGRATION_DATABASE_URL=postgresql://gym4me_migrator:replace-me@127.0.0.1:55434/gym4me_stage
NODE_ENV=production
PORT=7188
API_HOST=127.0.0.1
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_APPLICATION_ORIGIN=https://localhost:7181
AUTH_ADMIN_ORIGIN=https://localhost:7182
AUTH_BUSINESS_ORIGIN=https://localhost:7183
CORS_ORIGINS=https://localhost:7181,https://localhost:7182,https://localhost:7183,capacitor://localhost,https://localhost
PUBLIC_API_ORIGIN=https://localhost:7443
S3_ENDPOINT=http://127.0.0.1:8334
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET=gym4me-stage
RETENTION_ENABLED=false

KAVENEGAR_OTP_TEMPLATE=gym4meotp
# SMS key is loaded from apps/api/.env (never from web/native env).
